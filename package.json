{
  "name": "wishgranter",
  "version": "0.0.1",
  "description": "Modloader for Sleeper Game's Hyperspace Deck Command",
  "keywords": [
    "modloader",
    "mod-loader",
    "typescript",
    "TypeScript",
    "ts",
    "game"
  ],
  "homepage": "https://wishgranter.dev",
  "bugs": {
    "url": "https://github.com/Hederarch/HDC-Modloader/issues",
    "email": "claire@flechette.net"
  },
  "license": "CC-BY-SA-4.0",
  "author": {
    "name": "Claire Woods",
    "email": "claire@flechette.net",
    "url": "https://flechette.net"
  },
  "contributors": [
    {
      "name": "Hederarch",
      "url": "https://github.com/Hederarch"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Hederarch/HDC-Modloader.git"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!src/tests/",
    "!src/**/*_test.ts",
    "!dist/tests/",
    "!dist/**/*_test.js",
    "!dist/**/*_test.js.map",
    "!dist/**/*_test.d.ts",
    "!dist/**/*_test.d.ts.map"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/exports.d.ts",
        "default": "./dist/exports.js"
      }
    }
  },
  "bin": "./dist/cli.js",
  "man": "./man.1",
  "type": "module",
  "types": "./dist/exports.ts",
  "scripts": {
    "prepare": "npm run pretty && npm run build",
    "prelint": "npm run prety",
    "lint": "eslint src --cache --fix",
    "\n========== Building ==========": "",
    "prebuild": "npm run clean",
    "build": "tsc",
    "clean": "shx rm -rf ./dist/*",
    "pretty": "prettier --write src/**/*.ts",
    "\n========== Testing ==========": "",
    "pretest": "npm run build",
    "test": "mocha ",
    "\n========== Exporting ========": "",
    "run": "wishgranter --GUI"
  },
  "mocha": {
    "enable-source-maps": true,
    "spec": "./dist/**/*_test.js",
    "ui": "qunit",
    "require": "./dist/tests/hooks.js",
    "inline-diffs": true
  },
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "node-cleanup": "^2.1.2",
    "steam-locate": "^1.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/node-cleanup": "^2.1.5",
    "@types/sinon": "^21.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "shx": "^0.4.0",
    "sinon": "^21.0.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --fix",
    "*.{ts,js,css,md}": "prettier --write"
  }
}
