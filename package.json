{
  "name": "wishgranter",
  "version": "0.0.1",
  "description": "Modloader for Sleeper Game's Hyperspace Deck Command",
  "keywords": [
    "modloader",
    "mod-loader",
    "typescript",
    "TypeScript",
    "ts",
    "game"
  ],
  "homepage": "https://wishgranter.dev",
  "bugs": {
    "url": "https://github.com/Hederarch/HDC-Modloader/issues",
    "email": "claire@flechette.net"
  },
  "license": "CC-BY-SA-4.0",
  "author": {
    "name": "Claire Woods",
    "email": "claire@flechette.net",
    "url": "https://flechette.net"
  },
  "contributors": [
    {
      "name": "Hederarch",
      "url": "https://github.com/Hederarch"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Hederarch/HDC-Modloader.git"
  },
  "files": [
    "src/**/*.ts",
    "!src/forge.config.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "npm run pretty && npm run build",
    "prelint": "npm run pretty",
    "lint": "eslint src --cache --fix",
    "\n========== Building ==========": "",
    "prebuild": "npm run clean",
    "build": "tsc",
    "clean": "shx rm -rf ./dist/*",
    "pretty": "prettier --write src/**/*.ts",
    "\n========== Exporting ========": "",
    "prestart": "npm run build",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "optionalDependencies": {
    "steam-locate": "^1.0.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "degit": "^3.4.2",
    "electron": "^42.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "shx": "^0.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --fix",
    "*.{ts,js,css,md}": "prettier --write"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@41.7.1": true
  }
}
